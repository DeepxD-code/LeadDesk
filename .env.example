# LeadDesk configuration — copy to .env only if you need to change something.
# docker compose reads this file automatically when it is present.

# ---- Local AI (Ollama) -----------------------------------------------------
# Ollama runs on the host machine, not in a container.
OLLAMA_URL=http://host.docker.internal:11434
# Any model you have pulled: qwen2.5:3b (default, fast) or llama3.2:3b, gemma3:4b
LLM_MODEL=qwen2.5:3b
LLM_TIMEOUT=120

# ---- Vault encryption ------------------------------------------------------
# Two options, pick one:
#   1. leave these unset and the app generates secrets/vault_master.key on first run
#   2. set a key you manage yourself (32 raw bytes, base64 encoded)
#      python -c "import os,base64; print(base64.b64encode(os.urandom(32)).decode())"
# VAULT_MASTER_KEY=
# VAULT_MASTER_KEY_FILE=/app/secrets/vault_master.key
# VAULT_AUTOCREATE_KEY=1

# ---- Mail ------------------------------------------------------------------
# Compose ships Mailpit on 1025; read what was sent at http://localhost:8025
SMTP_HOST=mailpit
SMTP_PORT=1025
MAIL_FROM=LeadDesk Scheduler <scheduler@leaddesk.local>
# SMTP_DISABLED=1

# ---- Demo switches ---------------------------------------------------------
# SEED_DEMO=1 creates the team, SOPs, vault documents and interviews on first run
SEED_DEMO=1
# DEMO_MODE=1 shows the one-click sign-in buttons on the login screen.
#
# SET THIS TO 0 BEFORE YOU PUT THIS ON A PUBLIC URL. With DEMO_MODE=1 the login
# page hands out the administrator password to anyone who opens it.
DEMO_MODE=1

# The public base URL used inside booking links in emails.
# Use your real https URL in production: it also switches on Secure cookies.
PUBLIC_BASE_URL=http://localhost:8000

# ---- Google Calendar (optional) --------------------------------------------
# Create a Google OAuth web client and enable the Google Calendar API.
# Register this exact callback URL in the OAuth client:
# http://localhost:8000/api/iv/google/callback
# Keep the client secret out of Git. Calendar tokens are encrypted with the vault key.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:8000/api/iv/google/callback

# ---- Hardening (optional, sensible defaults) -------------------------------
# Sessions expire on the server after this many hours, whatever the cookie says.
# SESSION_HOURS=12
# Failed logins allowed before the account+IP pair is locked out.
# LOGIN_MAX_FAILURES=5
# LOGIN_LOCK_SECONDS=60
# External key provider (KMS/Vault CLI wrapper) that prints base64 32-byte KEK to stdout.
# VAULT_MASTER_KEY_COMMAND=
# ClamAV upload scanning (clamd INSTREAM). Set CLAMAV_REQUIRED=1 to fail closed.
# CLAMAV_HOST=
# CLAMAV_PORT=3310
# CLAMAV_REQUIRED=0
# Audit off-box shipping and alerting.
# AUDIT_SHIP_FILE=/var/log/leaddesk-audit.jsonl
# AUDIT_SHIP_URL=https://log-sink.example/ingest
# AUDIT_ALERT_WEBHOOK=https://alerts.example/webhook
# AUDIT_ALERT_DENIAL_THRESHOLD=5
# AUDIT_ALERT_WINDOW_MINUTES=15
